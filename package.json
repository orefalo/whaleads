{
  "name": "whaleads",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./ui/src/lib/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.worker.json && svelte-kit sync && svelte-check --tsconfig tsconfig.json --threshold error",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "node scripts/build-ui.mjs",
    "build:force": "FORCE_BUILD=1 node scripts/build-ui.mjs",
    "dev:ui": "vite dev",
    "test:e2e": "playwright test",
    "lint:template": "node scripts/check-deploy-template.mjs",
    "check": "npm run typecheck && npm run lint:template"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@lucide/svelte": "^1.80.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@aejkatappaja/phantom-ui": "^1.6.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@shardsui/svelte": "^0.1.0-beta.2",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.15",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.2"
  },
  "license": "Apache-2.0",
  "description": "A free WhatsApp lead inbox, CRM and automation builder you deploy to your own Cloudflare account.",
  "cloudflare": {
    "bindings": {
      "SESSION_SECRET": {
        "description": "Signs staff sessions and encrypts your saved WhatsApp connection. Use 32 or more random characters (`openssl rand -hex 32`). Keep a copy: you type it once on the **/setup** page after deploy."
      }
    }
  },
  "engines": {
    "node": ">=22.17"
  }
}
